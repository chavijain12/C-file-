#include <iostream>
using namespace std;
int main() {
    int n, original, rem;
    int sum = 0;
    cout << "enter a number : ";
    cin >> n;
    original = n;
    
    while (n > 0) {
rem = n % 10;
sum = sum + (rem*rem*rem);
n = n/10;
}
if (sum == original)
cout << "armstrong number";
else
cout << "not a armstrong number";

    return 0;
}
