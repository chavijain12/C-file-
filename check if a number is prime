#include <iostream>
using namespace std;
int main() {
    int n, count = 0;
    
    cout << "enter number ";
    cin >> n;
    if(n <= 1) {
        cout << "not a prime number";
        return 0;
    }
    for(int i = 2; i<=n; i++) {
        if (n % i == 0)
        count++;
    }
    if (count == 2)
    cout << "prime number" ;
    else
    cout << "not a prime number";
    return 0;
}
