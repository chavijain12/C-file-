#include <iostream>
#include <cmath>
using namespace std;

int main() {
    int num, digit;
    cout << "Enter a number: ";
    cin >> num;

    num = abs(num);        // negative number ko handle karne ke liye
    int largest = 0;       // smallest possible digit se start

    while (num > 0) {
        digit = num % 10;  // last digit nikalo
        if (digit > largest) {
            largest = digit;
        }
        num = num / 10;   // last digit remove
    }

    cout << "Largest digit = " << largest;

    return 0;
}
